# Copie para .env. Em produção, veja HOSPEDAGEM_HOSTINGER.md §4.
PORT=3000
APP_URL=http://localhost:3000
POSTGRES_PASSWORD=nuvem-dev
DATABASE_URL=postgresql://nuvem:nuvem-dev@localhost:5432/nuvemleads
# Banco separado para os testes de integração (criado automaticamente pelo npm test)
TEST_DATABASE_URL=postgresql://nuvem:nuvem-dev@localhost:5432/nuvemleads_test
SESSION_SECRET=gerar-com-openssl-rand-base64-48
UPLOAD_DIR=./.data/uploads
MAX_UPLOAD_MB=25
MAX_VIDEO_MB=100
PUBLIC_PICKER=false
ADMIN_SEED_NAME=Renata Alves
ADMIN_SEED_EMAIL=admin@seudominio.com.br
ADMIN_SEED_PASSWORD=trocar-no-primeiro-acesso
SEED_DEMO=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=nao-responda@seudominio.com.br
SMTP_PASS=
SMTP_FROM="NuvemLeads <nao-responda@seudominio.com.br>"
# Sem SMTP_PASS (dev/testes), os e-mails são gravados como JSON nesta pasta em vez de enviados
MAIL_OUTBOX=.data/outbox
