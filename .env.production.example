# Modelo do .env do VPS (HOSPEDAGEM_HOSTINGER.md §4, ARQUITETURA.md §10).
# Copie para ~/nuvemleads/.env no servidor e preencha. Nunca coloque este arquivo preenchido no Git.

# Domínio do chat (o Caddy emite o certificado para ele) e o endereço completo
APP_DOMAIN=chat.seudominio.com.br
APP_URL=https://chat.seudominio.com.br

# POSTGRES_PASSWORD e DATABASE_URL: gerados pelos comandos do §4 (openssl rand -hex 32)

# Uploads (o caminho dentro do contêiner já é /data/uploads)
MAX_UPLOAD_MB=25
MAX_VIDEO_MB=100

# Acesso só pelos links pessoais
PUBLIC_PICKER=false

# Admin criado no primeiro "node dist/seed.js". Troque a senha no primeiro acesso.
ADMIN_SEED_NAME=Renata Alves
ADMIN_SEED_EMAIL=admin@seudominio.com.br
ADMIN_SEED_PASSWORD=
# Nunca "true" em produção (o seed recusa)
SEED_DEMO=false

# E-mail de recuperação de senha do admin (§7). Em produção é obrigatório.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=nao-responda@seudominio.com.br
SMTP_PASS=
SMTP_FROM="NuvemLeads <nao-responda@seudominio.com.br>"
